[Unit]
Description=Display brightness that follows the ambient light sensor
Documentation=https://github.com/aurora-silicon/kbd-light
PartOf=graphical-session.target
After=graphical-session.target plasma-powerdevil.service
ConditionPathExistsGlob=/sys/bus/iio/devices/iio:device*/in_illuminance_input
ConditionPathExistsGlob=/sys/class/backlight/*

[Service]
ExecStart=/usr/bin/aurora-display-light
Restart=on-failure
RestartSec=5
Slice=background.slice
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
